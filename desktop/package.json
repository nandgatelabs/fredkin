{
  "name": "money-money-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Offline desktop shell for money-money (Electron + static web export)",
  "author": "Shivamrut <gshivamrut@gmail.com>",
  "homepage": "https://github.com/nandgatelabs/money-money",
  "desktopName": "money-money.desktop",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --linux AppImage deb",
    "pack:linux": "electron-builder --linux AppImage deb",
    "pack:win": "electron-builder --win nsis portable",
    "pack:mac": "electron-builder --mac dmg zip",
    "pack:dir": "electron-builder --linux AppImage --dir",
    "install-user": "bash scripts/install-user.sh"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "labs.nandgatelabs.moneymoney",
    "productName": "money-money",
    "executableName": "money-money",
    "copyright": "Copyright © 2026 Shivamrut (NandGateLabs)",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "../assets/images/icon.png",
      "synopsis": "Offline personal finance tracker",
      "description": "Offline-first personal finance app (expenses, income, budgets, analysis).",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "money-money",
          "Comment": "Offline personal finance tracker",
          "Categories": "Office;Finance;"
        }
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../assets/images/icon.png",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "money-money"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "../assets/images/icon.png",
      "category": "public.app-category.finance",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "money-money"
    }
  }
}
